# Roomly monorepo root
# Each subproject also carries its own ignore file.

# Stale folder shell left by a locked move; harmless (empty)
roomly_mobile/

# Local agent hooks generated by Copilot "modernize"
.github/modernize/

# --- IDEs ---
.idea/
.vscode/
*.iml
*.ipr
*.iws

# --- OS junk ---
.DS_Store
Thumbs.db

# --- Secrets (never commit) ---
.env
.env.backup
.env.production

# --- PHP / Laravel (defence in depth; backend/.gitignore keeps the same) ---
backend/vendor/
backend/node_modules/
backend/storage/*.key
backend/public/hot
backend/public/build
backend/public/storage
backend/.phpunit.cache/
backend/.phpunit.result.cache
backend/_ide_helper.php
backend/auth.json
backend/.nova/
backend/.zed/

# --- Flutter / Dart (mobile/.gitignore covers the rest) ---
mobile/.dart_tool/
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/coverage/
mobile/android/.gradle/
mobile/android/.kotlin/
mobile/android/app/debug
mobile/android/app/profile
mobile/android/app/release
