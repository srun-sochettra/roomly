{
  "info": {
    "name": "Roomly API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run a Login request first. The token is saved automatically."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "booking_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Student\",\n  \"email\": \"new@roomly.test\",\n  \"password\": \"password\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) pm.collectionVariables.set('token', pm.response.json().token);",
                  "pm.test('returns a token', () => pm.expect(pm.response.json()).to.have.property('token'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@roomly.test\",\n  \"password\": \"password\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) pm.collectionVariables.set('token', pm.response.json().token);",
                  "pm.test('returns a token', () => pm.expect(pm.response.json()).to.have.property('token'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@roomly.test\",\n  \"password\": \"password\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) pm.collectionVariables.set('token', pm.response.json().token);",
                  "pm.test('returns a token', () => pm.expect(pm.response.json()).to.have.property('token'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (wrong password) 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@roomly.test\",\n  \"password\": \"nope\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "me"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Rooms",
      "item": [
        {
          "name": "List rooms (with live availability)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/rooms",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rooms"
              ]
            }
          }
        },
        {
          "name": "Search rooms",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/rooms?search=Building A&type=Study room",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rooms"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Building A"
                },
                {
                  "key": "type",
                  "value": "Study room"
                }
              ]
            }
          }
        },
        {
          "name": "Room detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/rooms/2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rooms",
                "2"
              ]
            }
          }
        },
        {
          "name": "Room schedule for a day",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/rooms/2/schedule?date=2026-11-20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rooms",
                "2",
                "schedule"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "2026-11-20"
                }
              ]
            }
          }
        },
        {
          "name": "Create room (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/rooms",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rooms"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Podcast Booth\",\n  \"type\": \"Study room\",\n  \"capacity\": 3,\n  \"location\": \"Library, Floor 1\"\n}"
            }
          }
        },
        {
          "name": "Update room (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/rooms/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rooms",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Focus Pod A\",\n  \"type\": \"Study room\",\n  \"capacity\": 5,\n  \"location\": \"Building A, Floor 2\"\n}"
            }
          }
        },
        {
          "name": "Delete room (admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/rooms/7",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rooms",
                "7"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "My bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings"
              ]
            }
          }
        },
        {
          "name": "Create booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_id\": 1,\n  \"start_at\": \"2026-11-20 09:00:00\",\n  \"end_at\": \"2026-11-20 11:00:00\",\n  \"attendees\": 3,\n  \"purpose\": \"Group study\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('booking_id', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Overlapping booking 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_id\": 1,\n  \"start_at\": \"2026-11-20 10:00:00\",\n  \"end_at\": \"2026-11-20 12:00:00\",\n  \"attendees\": 2\n}"
            }
          }
        },
        {
          "name": "Over capacity 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_id\": 1,\n  \"start_at\": \"2026-11-21 09:00:00\",\n  \"end_at\": \"2026-11-21 10:00:00\",\n  \"attendees\": 50\n}"
            }
          }
        },
        {
          "name": "Booking detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings/{{booking_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings",
                "{{booking_id}}"
              ]
            }
          }
        },
        {
          "name": "Cancel my booking",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings/{{booking_id}}/cancel",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings",
                "{{booking_id}}",
                "cancel"
              ]
            }
          }
        },
        {
          "name": "Approve booking (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings/{{booking_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings",
                "{{booking_id}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            }
          }
        },
        {
          "name": "Reject booking (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings/{{booking_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings",
                "{{booking_id}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\",\n  \"admin_note\": \"Room under maintenance\"\n}"
            }
          }
        },
        {
          "name": "Cancel approved booking (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings/{{booking_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings",
                "{{booking_id}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"cancelled\",\n  \"admin_note\": \"Room needed for an official event\"\n}"
            }
          }
        },
        {
          "name": "Student hits admin route 403",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings/1/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings",
                "1",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            }
          }
        }
      ]
    }
  ]
}