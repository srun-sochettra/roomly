<file path="roomly_mobile/roomly_mobile/lib/services/api_service.dart">
import 'dart:async';
import 'dart:convert';

import 'package:http/http.dart' as http;
import 'package:intl/intl.dart';

import '../config.dart';
import '../models/booking.dart';
import '../models/room.dart';
import '../models/user.dart';

class ApiException implements Exception {
  final String message;
  final int? status;
  const ApiException(this.message, [this.status]);

  @override
  String toString() => message;
}

class ApiService {
  ApiService({this.onUnauthorized});

  String? token;
  final void Function()? onUnauthorized;
  final _client = http.Client();
  static final _wireFormat = DateFormat('yyyy-MM-dd HH:mm:ss');

  Future<dynamic> _send(String method, String path, {Map<String, dynamic>? body, Map<String, String>? query}) async {
    final uri = Uri.parse('${AppConfig.baseUrl}$path').replace(queryParameters: query);
    final request = http.Request(method, uri)
      ..headers.addAll({
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        if (token != null) 'Authorization': 'Bearer $token',
      });
    if (body != null) request.body = jsonEncode(body);

    final http.Response res;
    try {
      res = await http.Response.fromStream(await _client.send(request).timeout(const Duration(seconds: 15)));
    } on TimeoutException {
      throw const ApiException('The server took too long to respond. Try again.');
    } catch (_) {
      throw const ApiException('Can’t reach the server. Check your connection and the API URL.');
    }

    final data = res.body.isEmpty ? null : jsonDecode(res.body);
    if (res.statusCode >= 200 && res.statusCode < 300) return data;

    if (res.statusCode == 401 && token != null) onUnauthorized?.call();
    throw ApiException(_errorMessage(data), res.statusCode);
  }

  /// Laravel validation errors look like {message, errors: {field: [msg]}}. Show the first field message.
  String _errorMessage(dynamic data) {
    if (data is Map<String, dynamic>) {
      final errors = data['errors'];
      if (errors is Map && errors.isNotEmpty) {
        final first = errors.values.first;
        if (first is List && first.isNotEmpty) return first.first.toString();
      }
      if (data['message'] is String) return data['message'] as String;
    }
    return 'Something went wrong. Please try again.';
  }

  // Auth
  Future<(String, AppUser)> login(String email, String password) =>
      _auth('/login', {'email': email, 'password': password});

  Future<(String, AppUser)> register(String name, String email, String password) =>
      _auth('/register', {'name': name, 'email': email, 'password': password});

  Future<(String, AppUser)> _auth(String path, Map<String, dynamic> body) async {
    final data = await _send('POST', path, body: body) as Map<String, dynamic>;
    return (data['token'] as String, AppUser.fromJson(data['user'] as Map<String, dynamic>));
  }

  Future<AppUser> me() async => AppUser.fromJson((await _send('GET', '/me'))['data'] as Map<String, dynamic>);

  Future<void> logout() => _send('POST', '/logout');

  // Rooms
  Future<List<Room>> rooms({String? search, String? type}) async {
    final data = await _send('GET', '/rooms', query: {
      if (search != null && search.isNotEmpty) 'search': search,
      if (type != null) 'type': type,
    });
    return (data['data'] as List).map((e) => Room.fromJson(e as Map<String, dynamic>)).toList();
  }

  /// Taken slots for one day, for the room timeline.
  Future<List<Slot>> schedule(int roomId, DateTime day) async {
    final data = await _send('GET', '/rooms/$roomId/schedule', query: {'date': DateFormat('yyyy-MM-dd').format(day)});
    return (data['data'] as List).map((e) => Slot.fromJson(e as Map<String, dynamic>)).toList();
  }

  // Bookings
  Future<List<Booking>> myBookings() async {
    final data = await _send('GET', '/bookings');
    return (data['data'] as List).map((e) => Booking.fromJson(e as Map<String, dynamic>)).toList();
  }

  Future<Booking> createBooking({
    required int roomId,
    required DateTime start,
    required DateTime end,
    required int attendees,
    String? purpose,
  }) async {
    final data = await _send('POST', '/bookings', body: {
      'room_id': roomId,
      'start_at': _wireFormat.format(start),
      'end_at': _wireFormat.format(end),
      'attendees': attendees,
      if (purpose != null && purpose.isNotEmpty) 'purpose': purpose,
    });
    return Booking.fromJson(data['data'] as Map<String, dynamic>);
  }

  Future<void> cancelBooking(int id) => _send('PATCH', '/bookings/$id/cancel');
}
</file>

<file path="roomly_mobile/roomly_mobile/lib/state/auth_provider.dart">
import 'package:flutter/foundation.dart';
import 'package:shared_preferences/shared_preferences.dart';

import '../models/user.dart';
import '../services/api_service.dart';

enum AuthStatus { unknown, signedIn, signedOut }

class AuthProvider extends ChangeNotifier {
  static const _tokenKey = 'auth_token';
  static const adminMessage = 'Admin accounts use the web panel at /admin. Sign in here with a student account.';

  late final ApiService api = ApiService(onUnauthorized: _clearSession);
  AuthStatus status = AuthStatus.unknown;
  AppUser? user;

  /// Restore a saved session on app start.
  Future<void> init() async {
    final prefs = await SharedPreferences.getInstance();
    api.token = prefs.getString(_tokenKey);
    if (api.token == null) {
      _set(AuthStatus.signedOut);
      return;
    }
    try {
      final me = await api.me();
      if (me.role == 'admin') {
        await logout();
        return;
      }
      user = me;
      _set(AuthStatus.signedIn);
    } on ApiException catch (e) {
      // Drop the saved token only if the server rejected it; when offline, keep it for next launch.
      if (e.status == 401) {
        await _clearSession();
      } else {
        _set(AuthStatus.signedOut);
      }
    }
  }

  Future<void> login(String email, String password) async => _save(await api.login(email, password));

  Future<void> register(String name, String email, String password) async =>
      _save(await api.register(name, email, password));

  Future<void> logout() async {
    try {
      await api.logout();
    } catch (_) {
      // Sign out locally even if the server is unreachable.
    }
    await _clearSession();
  }

  Future<void> _save((String, AppUser) result) async {
    final (token, signedIn) = result;

    // The app is for students. Revoke the admin's fresh token and point them to the web panel.
    if (signedIn.role == 'admin') {
      api.token = token;
      try {
        await api.logout();
      } catch (_) {}
      api.token = null;
      throw const ApiException(adminMessage, 403);
    }

    api.token = token;
    user = signedIn;
    (await SharedPreferences.getInstance()).setString(_tokenKey, token);
    _set(AuthStatus.signedIn);
  }

  Future<void> _clearSession() async {
    api.token = null;
    user = null;
    (await SharedPreferences.getInstance()).remove(_tokenKey);
    _set(AuthStatus.signedOut);
  }

  void _set(AuthStatus s) {
    status = s;
    notifyListeners();
  }
}
</file>

<file path="roomly_mobile/roomly_mobile/lib/state/theme_provider.dart">
import 'package:flutter/material.dart';
import 'package:shared_preferences/shared_preferences.dart';

/// Holds the chosen theme (System / Light / Dark) and remembers it between launches.
/// Any widget that watches it rebuilds when the user changes the setting.
class ThemeProvider extends ChangeNotifier {
  static const _key = 'theme_mode';

  ThemeMode mode = ThemeMode.system;

  Future<void> init() async {
    final saved = (await SharedPreferences.getInstance()).getString(_key);
    mode = ThemeMode.values.asNameMap()[saved] ?? ThemeMode.system;
    notifyListeners();
  }

  Future<void> setMode(ThemeMode next) async {
    if (next == mode) return;
    mode = next;
    notifyListeners();
    await (await SharedPreferences.getInstance()).setString(_key, next.name);
  }

  /// Quick toggle: flips whatever is currently on screen.
  void toggle(Brightness current) => setMode(current == Brightness.dark ? ThemeMode.light : ThemeMode.dark);
}
</file>

